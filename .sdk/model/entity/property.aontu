                or: "minPrice"
                r: false
                t: "`$NUMBER`"
              }
              {
                k: "query"
                n: "operator"
                or: "operator"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 20
                k: "query"
                n: "page_size"
                or: "pageSize"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
