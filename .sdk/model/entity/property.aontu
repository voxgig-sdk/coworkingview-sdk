            ]
          }
          m: "GET"
          o: "/v1/properties"
          q: {
            exist: [
              "locale"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "properties"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          co: {
            id: "GET /v1/properties/map"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "address"
                or: "address"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "amenity"
                or: "amenities"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "13.2,52.4,13.6,52.6"
                k: "query"
