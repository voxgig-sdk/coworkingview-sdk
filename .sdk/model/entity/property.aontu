  id: {
    field: "slug"
    name: "id"
  }

  name: "property"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/properties"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "address"
                or: "address"
