    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/properties/{slug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "hq-kings-cross-london"
                k: "param"
                n: "id"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "en"
                k: "query"
                n: "locale"
                or: "locale"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/properties/{slug}"
          q: {
            exist: [
              "id"
              "locale"
            ]
          }
          r: {
            param: {
              slug: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "properties"
