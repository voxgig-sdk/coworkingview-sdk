      fo: "date-time"
      h: "Updated At"
      n: "updatedAt"
      r: false
      sh: "When the underlying CMS record was last updated."
      t: "`$STRING`"
    }
    webUrl: {
      fo: "uri"
      h: "Web Url"
      n: "webUrl"
