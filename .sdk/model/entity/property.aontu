                or: "minCapacity"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "min_price"
                or: "minPrice"
                r: false
                t: "`$NUMBER`"
              }
              {
                k: "query"
                n: "operator"
                or: "operator"
                r: false
